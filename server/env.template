# MongoDB Connection
# Option 1: MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/sakshamsetu?retryWrites=true&w=majority
# Option 2: Local MongoDB
MONGO_URI=mongodb://localhost:27017/sakshamsetu
MONGO_DB_NAME=sakshamsetu

# Server Port
PORT=4000

